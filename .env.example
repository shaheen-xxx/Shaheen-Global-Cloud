# PostgreSQL
DATABASE_URL=postgresql://shaheen:shaheen_password@postgres:5432/shaheen_cloud
POSTGRES_USER=shaheen
POSTGRES_PASSWORD=shaheen_password
POSTGRES_DB=shaheen_cloud

# Redis
REDIS_URL=redis://redis:6379/0

# FastAPI
FASTAPI_ENV=development
FASTAPI_DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Dagger
DAGGER_WORKDIR=/tmp/dagger-work
DAGGER_CACHE_DIR=/tmp/dagger-cache

# OpenTofu/Terraform
TF_VAR_provider=hetzner

# Logging
LOG_LEVEL=DEBUG

# Frontend
VITE_API_URL=http://localhost:8000/api

# Hetzner (example - will be set at runtime)
# HETZNER_API_TOKEN=your-token-here

# AWS (future)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# DigitalOcean (future)
# DIGITALOCEAN_TOKEN=your-token
